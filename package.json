{
  "name": "release-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Local, read-only Jira release calendar and CLI",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "release-calendar": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "check": "tsc --noEmit",
    "test": "pnpm build && vitest run --config vitest.config.ts",
    "start": "node dist/cli.js serve",
    "cli": "node dist/cli.js",
    "format": "biome format --write src tests web",
    "test:oauth": "pnpm build && node scripts/oauth-qa.mjs && node scripts/oauth-lifecycle-qa.mjs && node scripts/codex-qa.mjs",
    "test:settings": "pnpm build && node scripts/settings-qa.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "desktop:build": "pnpm build && node scripts/build-macos.mjs",
    "desktop": "open \"desktop-build/Release Calendar.app\"",
    "test:desktop": "pnpm desktop:build && node scripts/native-qa.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "hono": "^4.13.13",
    "ky": "^2.2.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.0",
    "playwright-lighthouse": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
