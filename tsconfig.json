{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "esModuleInterop": true, "outDir": "dist", "types": ["node"]
  },
  "include": ["src", "tests", "web", "vite.config.ts", "vitest.config.ts"]
}
